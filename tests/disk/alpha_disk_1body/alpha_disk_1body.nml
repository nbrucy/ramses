!This namelist contains various input parameters for RAMSES runs

&RUN_PARAMS  
hydro=.true.
poisson=.true.
pic=.false.
ncontrol=1
nremap=1000
nrestart=0
nsubcycle=6*2
sink=.false.
clumpfind=.false.
nstepmax = 8000000
!verbose=.true.
/


&AMR_PARAMS 
levelmin=9
levelmax=12
ngridmax=5000000
npartmax=0
nexpand=1
boxlen=8.
/


&INIT_PARAMS
condinit_kind='alpha_disk'
/

&OUTPUT_PARAMS
delta_tout = 0.5
tend = 2000.
foutput=10
/

&POISSON_PARAMS 
gravity_type=2
gravity_params=1.,0.06,4.,4.,4.
/

&BOUNDARY_PARAMS
use_special_boundary=.true.
special_boundary_kind="alpha_disk"
/

&HYDRO_PARAMS
gamma=1.66666667
courant_factor=0.8
slope_type=1
scheme='muscl'
riemann='hllc'
smallr=1.d-5
add_viscosity=.true.
viscosity_kind="alpha"
alpha_viscosity=0.1
pressure_fix=.false.
/

&COOLING_PARAMS
cooling=.true.
/

&REFINE_PARAMS
jeans_refine=9*1d9
interpol_var=1
interpol_type=1
r_refine=2*6,4. ! BEWARE DIAMETER !!!!!!
a_refine=8*1.0
b_refine=8*0.08
exp_refine=8*2.0
x_refine=8*4
y_refine=8*4
z_refine=8*4
/


&DISK_PARAMS
disk_radius=1.
inner_boundary=0.5
outer_boundary=3
disk_density=1.
h_over_r=0.1
damping=.true.
damping_time=1.
damping_inner_boundary=0.4
disk_local_isothermal=.true.
/
